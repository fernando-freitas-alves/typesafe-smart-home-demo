# Used only by the local smart-home demo server. Never exposed to the browser.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Local demo defaults to Anthropic. Use chatgpt for the shared subscription helper.
LLM_PROVIDER=anthropic
# Optional: enables the video’s live LLM split and general-answer branches.
# Without it, the UI explicitly labels its limited local fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: enables the separate /live page. Never commit real values.
# HA base URL reachable from this computer, without /api or dashboard paths.
HA_URL=
# Long-Lived Access Token from your Home Assistant profile.
HA_TOKEN=
# Switches are read only unless explicitly listed here, comma-separated.
HA_SWITCH_ENTITIES=
