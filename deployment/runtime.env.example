# This file is a template. Copy to runtime.env on the HA server (chmod 600).
CHAT_BRIDGE_TOKEN=replace-with-at-least-32-random-characters
TYPESAFE_API_KEY=your-typesafe-key
TYPESAFE_MODEL=jev-latest
# ChatGPT is connected by an HA admin in Home chat → AI settings.
# Its refreshable login is stored in data/chatgpt/, not in this file.
# Optional comma-separated switch entity IDs allowed for control.
HA_SWITCH_ENTITIES=
